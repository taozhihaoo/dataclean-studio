# DataClean Studio configuration
# Copy to .env and adjust as needed. Everything works with the defaults below —
# no API key is required for any core feature.

# Directory for uploads, parsed datasets, exports and the SQLite database.
# Created automatically. Mount as a volume in Docker for persistence.
DATA_CLEAN_DATA_DIR=data

# Maximum accepted upload size in megabytes.
DATA_CLEAN_MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# OPTIONAL: AI schema inference (off by default)
# ---------------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to use the built-in deterministic heuristic
# mapping only. The heuristic provider needs no key and no network access.
# If you set a key, the "openai" provider becomes available in the UI:
# it sends column names plus up to 3 sample values per column to the API,
# and only when you explicitly click "Suggest mapping with AI".
# OPENAI_API_KEY=
# DATA_CLEAN_OPENAI_MODEL=gpt-4o-mini
# DATA_CLEAN_OPENAI_BASE_URL=https://api.openai.com/v1
# DATA_CLEAN_OPENAI_TIMEOUT=20
